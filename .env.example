# ===== DeepSeek API =====
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
REQUEST_TIMEOUT=60

# ===== 演示模式 =====
# true 时不调用 API，AI 返回固定演示内容（面试演示推荐，零成本）
MOCK_AI=false

# ===== Web 控制台 =====
WEB_HOST=127.0.0.1
WEB_PORT=8000
LOG_LEVEL=INFO
DEBUG=false
